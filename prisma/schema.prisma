datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. CANONICAL ENTERPRISE ENUMS
// ==========================================

enum Role {
  ADMIN
  CATALOG_EDITOR
  CATALOG_REVIEWER
  WAREHOUSE_MANAGER
  PURCHASING_OFFICER
  SALES_REPRESENTATIVE
  SALES_MANAGER
  FINANCE_CLERK
  FINANCE_AUDITOR
  EXECUTIVE
}

enum ProductStatus {
  DRAFT
  STAGED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  RESERVED
  PICKING
  PACKING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  WIRE_TRANSFER
  ACH
  CHECK
  CASH
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  TRANSFER
  DAMAGE
  FOUND_STOCK
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum WarehouseBinType {
  PICK
  BULK
  QUARANTINE
  RETURNS
  HAZMAT
}

enum WorkflowType {
  PO_APPROVAL
  CATALOG_REVIEW
  MONTH_END_CLOSE
  CREDIT_EXCEPTION
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  USER_CREATED
  USER_UPDATED
  ROLE_ASSIGNED
  PRODUCT_STAGED
  PRODUCT_PUBLISHED
  STOCK_ADJUSTED
  PO_APPROVED
  ORDER_PLACED
  INVOICE_POSTED
  PERIOD_LOCKED
}

enum IngestionStatus {
  INGESTED
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// 2. IDENTITY & ACCESS MANAGEMENT (IAM / SECURITY)
// ==========================================

model Company {
  id          String    @id @default(cuid())
  code        String    @unique
  legalName   String    @map("legal_name")
  displayName String    @map("display_name")
  taxId       String?   @map("tax_id")
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(1)
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users               User[]
  products            Product[]
  customers           Customer[]
  warehouses          Warehouse[]
  suppliers           Supplier[]
  salesOrders         SalesOrder[]
  salesQuotations     SalesQuotation[]
  invoices            Invoice[]
  auditLogs           AuditLog[]
  domainEvents        DomainEvent[]
  outboxMessages      OutboxMessage[]
  systemSettings      SystemSetting[]
  workflowDefinitions WorkflowDefinition[]
  notifications       Notification[]
  aiJobs              AIJob[]
  reportSchedules     ReportSchedule[]

  @@map("companies")
}

model User {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         Role      @default(SALES_REPRESENTATIVE)
  isActive     Boolean   @default(true) @map("is_active")
  version      Int       @default(1)
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([companyId])
  @@index([email])
  @@index([companyId, role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String      @map("company_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entityName String      @map("entity_name")
  entityId   String?     @map("entity_id")
  details    Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, action])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// 3. PRODUCT INFORMATION MANAGEMENT (PIM DOMAIN)
// ==========================================

model Category {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  name      String
  slug      String
  parentId  String?   @map("parent_id")
  version   Int       @default(1)
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  name      String
  logoUrl   String?   @map("logo_url")
  version   Int       @default(1)
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model Product {
  id           String        @id @default(cuid())
  companyId    String        @map("company_id")
  sku          String
  title        String
  description  String?
  categoryId   String?       @map("category_id")
  brandId      String?       @map("brand_id")
  supplierId   String?       @map("supplier_id")
  price        Decimal       @db.Decimal(19, 4)
  costPrice    Decimal       @map("cost_price") @db.Decimal(19, 4)
  status       ProductStatus @default(DRAFT)
  qualityScore Int           @default(0) @map("quality_score")
  version      Int           @default(1)
  createdBy    String?       @map("created_by")
  updatedBy    String?       @map("updated_by")
  deletedBy    String?       @map("deleted_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  variants      ProductVariant[]
  assets        ProductAsset[]
  digitalAssets DigitalAsset[]
  inventory     InventoryItem[]
  orderLines    SalesOrderLine[]
  poLines       PurchaseOrderLine[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, sku])
  @@index([companyId, supplierId])
  @@index([companyId, createdAt])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  variantSku String   @map("variant_sku")
  name       String
  price      Decimal  @db.Decimal(19, 4)
  options    Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductAsset {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  assetUrl  String   @map("asset_url")
  assetType String   @default("IMAGE") @map("asset_type")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_assets")
}

model DigitalAsset {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  fileName  String   @map("file_name")
  fileUrl   String   @map("file_url")
  mimeType  String   @map("mime_type")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("digital_assets")
}

// ==========================================
// 4. INVENTORY & WAREHOUSE (WMS DOMAIN)
// ==========================================

model InventoryItem {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  productId    String   @map("product_id")
  warehouseId  String   @map("warehouse_id")
  onHandQty    Int      @default(0) @map("on_hand_qty")
  reservedQty  Int      @default(0) @map("reserved_qty")
  availableQty Int      @default(0) @map("available_qty")
  reorderLevel Int      @default(10) @map("reorder_level")
  version      Int      @default(1)
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]
  reservations StockReservation[]

  @@unique([companyId, productId, warehouseId])
  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@index([companyId, availableQty])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  companyId       String                   @map("company_id")
  inventoryItemId String                   @map("inventory_item_id")
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Int
  reference       String?
  createdAt       DateTime                 @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([inventoryItemId])
  @@map("inventory_transactions")
}

model StockReservation {
  id              String   @id @default(cuid())
  inventoryItemId String   @map("inventory_item_id")
  salesOrderId    String   @map("sales_order_id")
  reservedQty     Int      @map("reserved_qty")
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([salesOrderId])
  @@map("stock_reservations")
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  code      String
  name      String
  address   String?
  version   Int       @default(1)
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bins      WarehouseBin[]
  inventory InventoryItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model WarehouseBin {
  id          String           @id @default(cuid())
  warehouseId String           @map("warehouse_id")
  binCode     String           @map("bin_code")
  binType     WarehouseBinType @default(PICK) @map("bin_type")
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, binCode])
  @@index([warehouseId])
  @@map("warehouse_bins")
}

// ==========================================
// 5. PURCHASING & VENDOR DOMAIN
// ==========================================

model Supplier {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  code      String
  name      String
  email     String?
  phone     String?
  version   Int       @default(1)
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]
  pos      PurchaseOrder[]
  contacts SupplierContact[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  poNumber    String    @map("po_number")
  supplierId  String    @map("supplier_id")
  status      POStatus  @default(DRAFT)
  totalAmount Decimal   @map("total_amount") @db.Decimal(19, 4)
  version     Int       @default(1)
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@index([companyId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  companyId       String  @map("company_id")
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  orderedQty      Int     @map("ordered_qty")
  unitCost        Decimal @map("unit_cost") @db.Decimal(19, 4)
  totalCost       Decimal @map("total_cost") @db.Decimal(19, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String   @map("purchase_order_id")
  receiptNumber   String   @map("receipt_number")
  receivedDate    DateTime @default(now()) @map("received_date")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

// ==========================================
// 6. ORDER MANAGEMENT SYSTEM (OMS DOMAIN)
// ==========================================

model SalesQuotation {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  quoteNumber String   @map("quote_number")
  customerId  String   @map("customer_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(19, 4)
  validUntil  DateTime @map("valid_until")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([customerId])
  @@map("sales_quotations")
}

model SalesOrder {
  id          String      @id @default(cuid())
  companyId   String      @map("company_id")
  orderNumber String      @map("order_number")
  customerId  String      @map("customer_id")
  status      OrderStatus @default(DRAFT)
  subtotal    Decimal     @db.Decimal(19, 4)
  taxTotal    Decimal     @map("tax_total") @db.Decimal(19, 4)
  shippingFee Decimal     @map("shipping_fee") @db.Decimal(19, 4)
  totalAmount Decimal     @map("total_amount") @db.Decimal(19, 4)
  version     Int         @default(1)
  createdBy   String?     @map("created_by")
  updatedBy   String?     @map("updated_by")
  deletedBy   String?     @map("deleted_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines     SalesOrderLine[]
  shipments Shipment[]
  invoice   Invoice?

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, orderNumber])
  @@index([companyId, createdAt])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(cuid())
  companyId    String  @map("company_id")
  salesOrderId String  @map("sales_order_id")
  productId    String  @map("product_id")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(19, 4)
  totalPrice   Decimal @map("total_price") @db.Decimal(19, 4)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model Shipment {
  id             String   @id @default(cuid())
  salesOrderId   String   @map("sales_order_id")
  trackingNumber String   @map("tracking_number")
  carrier        String
  shippedAt      DateTime @default(now()) @map("shipped_at")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@map("shipments")
}

// ==========================================
// 7. CUSTOMER RELATIONSHIP MANAGEMENT (CRM DOMAIN)
// ==========================================

model Customer {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  customerCode String    @map("customer_code")
  legalName    String    @map("legal_name")
  email        String
  phone        String?
  creditLimit  Decimal   @default(0) @map("credit_limit") @db.Decimal(19, 4)
  creditHold   Boolean   @default(false) @map("credit_hold")
  version      Int       @default(1)
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contacts  CustomerContact[]
  addresses CustomerAddress[]
  orders    SalesOrder[]
  invoices  Invoice[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([companyId, customerCode])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  addressType String   @default("SHIPPING") @map("address_type")
  street      String
  city        String
  state       String
  postalCode  String   @map("postal_code")
  country     String
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ==========================================
// 8. FINANCE & ACCOUNTING DOMAIN
// ==========================================

model Invoice {
  id            String        @id @default(cuid())
  companyId     String        @map("company_id")
  invoiceNumber String        @map("invoice_number")
  salesOrderId  String?       @unique @map("sales_order_id")
  customerId    String        @map("customer_id")
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(19, 4)
  dueDate       DateTime      @map("due_date")
  postedAt      DateTime?     @map("posted_at")
  version       Int           @default(1)
  createdBy     String?       @map("created_by")
  updatedBy     String?       @map("updated_by")
  deletedBy     String?       @map("deleted_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salesOrder  SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, invoiceNumber])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  companyId String        @map("company_id")
  invoiceId String        @map("invoice_id")
  amount    Decimal       @db.Decimal(19, 4)
  method    PaymentMethod @default(WIRE_TRANSFER)
  reference String?
  version   Int           @default(1)
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([invoiceId])
  @@map("payments")
}

model CreditNote {
  id        String   @id @default(cuid())
  invoiceId String   @map("invoice_id")
  cnNumber  String   @map("cn_number")
  amount    Decimal  @db.Decimal(19, 4)
  reason    String
  issuedAt  DateTime @default(now()) @map("issued_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("credit_notes")
}

// ==========================================
// 9. WORKFLOW AUTOMATION DOMAIN
// ==========================================

model WorkflowDefinition {
  id           String              @id @default(cuid())
  companyId    String              @map("company_id")
  name         String
  workflowType WorkflowType        @map("workflow_type")
  rules        Json
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  executions WorkflowExecution[]

  @@index([companyId])
  @@map("workflow_definitions")
}

model WorkflowExecution {
  id           String             @id @default(cuid())
  definitionId String             @map("definition_id")
  status       WorkflowStatus     @default(PENDING)
  triggerEvent String             @map("trigger_event")
  createdAt    DateTime           @default(now()) @map("created_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("workflow_executions")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("notifications")
}

// ==========================================
// 10. AI CATALOG INTELLIGENCE DOMAIN
// ==========================================

model AIJob {
  id        String          @id @default(cuid())
  companyId String          @map("company_id")
  fileUrl   String          @map("file_url")
  status    IngestionStatus @default(INGESTED)
  createdAt DateTime        @default(now()) @map("created_at")

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recommendations AIRecommendation[]

  @@index([companyId])
  @@map("ai_jobs")
}

model AIRecommendation {
  id            String   @id @default(cuid())
  jobId         String   @map("job_id")
  title         String
  suggestedSku  String   @map("suggested_sku")
  extractedData Json     @map("extracted_data")
  createdAt     DateTime @default(now()) @map("created_at")

  job         AIJob               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  confidences AIConfidenceScore[]

  @@index([jobId])
  @@map("ai_recommendations")
}

model AIConfidenceScore {
  id               String   @id @default(cuid())
  recommendationId String   @map("recommendation_id")
  fieldName        String   @map("field_name")
  score            Float
  createdAt        DateTime @default(now()) @map("created_at")

  recommendation AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("ai_confidence_scores")
}

// ==========================================
// 11. REPORTING, SYSTEM & INFRASTRUCTURE
// ==========================================

model ReportSchedule {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  reportName String   @map("report_name")
  cronExpr   String   @map("cron_expr")
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("report_schedules")
}

model HealthCheck {
  id        String   @id @default(cuid())
  status    String   @default("OK")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

model SystemSetting {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@index([companyId])
  @@map("system_settings")
}

model DomainEvent {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  processedAt   DateTime? @map("processed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, eventType])
  @@index([companyId, aggregateType, aggregateId])
  @@map("domain_events")
}

model OutboxMessage {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("PENDING")
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime? @map("next_attempt_at")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}
